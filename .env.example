# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# The test-user provisioning helper reads the same project URL server-side.
SUPABASE_URL=your_supabase_url

# Other configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
CONTACT_WEBHOOK_URL=https://your-approved-form-processor.example/webhook
# Protects app/api/cron/crm-notifications; the route is currently a no-send stub.
CRM_CRON_SECRET=replace_with_a_long_random_secret

# Resend (transactional email) - used for auth-flow emails (signup confirm,
# password reset, PM/admin invite). See lib/email/resend.js + templates.js.
RESEND_API_KEY=your_resend_api_key
# The sender is fixed in lib/email/resend.js; its domain must be verified in Resend.
