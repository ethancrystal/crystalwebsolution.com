# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# The test-user provisioning helper reads the same project URL server-side.
SUPABASE_URL=your_supabase_url
# Consumed by supabase/config.toml's auth.site_url. Use http://127.0.0.1:3000
# locally and https://crystalwebsolution.com for the deployed project. The
# matching redirect allow-list is committed in supabase/config.toml.
SUPABASE_AUTH_SITE_URL=http://127.0.0.1:3000

# Other configuration
# Base URL used to build every emailed auth link (lib/supabase/admin.js
# buildVerifyUrl). Must be a URL that is allow-listed in Supabase Auth.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. When set, the contact route also forwards briefs to this processor.
# Delivery now succeeds if either the webhook or Resend accepts the message.
CONTACT_WEBHOOK_URL=https://your-approved-form-processor.example/webhook
# Protects app/api/cron/crm-notifications, which drains notifications_outbox.
# Accepted as either `Authorization: Bearer <secret>` or `x-cron-secret`.
# On Vercel, name it CRON_SECRET instead: Vercel Cron sends that value as a
# bearer token automatically and cannot send custom headers. The route accepts
# either variable, so set whichever suits the host. Unset = endpoint disabled.
CRM_CRON_SECRET=replace_with_a_long_random_secret

# Resend (transactional email) - the single delivery boundary for auth-flow
# email (signup confirm, resend confirm, password reset, password-changed
# notice, staff invite), CRM notification fan-out, and contact-form alerts.
# See lib/email/resend.js + lib/email/templates.js.
RESEND_API_KEY=your_resend_api_key
# Sender identity. The domain must be verified in Resend or every send fails.
# Defaults to "Crystal Web Solution <no-reply@crystalwebsolution.com>".
RESEND_FROM_EMAIL=Crystal Web Solution <no-reply@crystalwebsolution.com>
# Where replies go. Defaults to SITE.email (info@crystalwebsolution.com).
RESEND_REPLY_TO=info@crystalwebsolution.com
# Inbox that receives contact-form briefs. Defaults to SITE.email.
CONTACT_NOTIFICATION_EMAIL=info@crystalwebsolution.com
