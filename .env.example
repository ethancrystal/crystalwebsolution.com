# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Other configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional email) - used for auth-flow emails (signup confirm,
# password reset, PM/admin invite). See lib/email/resend.js + templates.js.
RESEND_API_KEY=your_resend_api_key
# Must be on a domain verified in your Resend account, or sends will fail.
RESEND_FROM_EMAIL="Crystal Web Solution <noreply@yourdomain.com>"
