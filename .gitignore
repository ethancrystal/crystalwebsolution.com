# Windows / OneDrive artifacts. These get written into the working tree by
# Explorer, Chrome downloads and OneDrive sync; none of them belong to the
# project and they make `git status` noisy enough to hide real changes.
*:Zone.Identifier
desktop.ini
*.lnk
/Claude/
/Colab Notebooks/
/onedrive/
FireShot Capture*

# Generated scan/report output (repo-scan, code-analysis, audits). These are
# regenerated on demand and were previously committed by mistake.
/output/
/test-results/

# agent-council skill working/log output (council_archive/, council_log.jsonl)
# and stray `$null` files from PowerShell `> $null` redirects being
# misinterpreted as a literal filename — none of these belong in the repo,
# and both were previously committed by mistake.
/council_archive/
council_log.jsonl
$null

# Auto-generated by `next dev`/`next build` once tsconfig.json is present;
# local incremental type-check cache.
next-env.d.ts
tsconfig.tsbuildinfo

