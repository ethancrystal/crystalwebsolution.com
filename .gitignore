/public/temp-logo-preview.png

# Local linked worktrees and recoverable cleanup staging
/.worktrees/
/.claude/worktrees/
/_to_delete/

# Google Drive desktop upload staging. Drive creates this inside the working
# tree and fills it with six-figure counts of numeric temp files, which makes
# `git status` crawl. Drive owns these — ignore them, never commit them.
/.tmp.driveupload/
