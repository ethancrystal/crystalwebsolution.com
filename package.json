{
  "name": "crystal-web-solution",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs tests/crm/*.test.mjs",
    "test:crm": "node --test tests/crm/*.test.mjs",
    "test:marketing": "vitest run tests/marketing",
    "test:db": "supabase test db",
    "test:e2e": "playwright test tests/e2e",
    "crm:verify": "pnpm test:crm && pnpm test:db",
    "crm:verify:preview": "CRM_PREVIEW_ENVIRONMENT=preview node scripts/verify-crm-preview-authorization.mjs",
    "crm:provision-test-users": "node scripts/provision-crm-test-users.mjs",
    "livecheck": "node scripts/livecheck.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@sentry/nextjs": "^10.71.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "next": "^16.3.3",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.24.0",
    "split-type": "^0.3.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "supabase": "^2.115.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
